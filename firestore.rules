rules_version = '2';
// =============================================================
//  アニマルモンスター  Cloud Firestore セキュリティルール
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function playerDoc(pid) { return get(/databases/$(database)/documents/players/$(pid)); }
    // そのプレイヤー(pid)の持ち主が自分か
    function isOwner(pid) {
      return signedIn()
        && exists(/databases/$(database)/documents/players/$(pid))
        && playerDoc(pid).data.owner == request.auth.uid;
    }

    // ---------- プレイヤー ----------
    match /players/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
      allow update: if signedIn() && (
        // 自分のデータの更新（持ち主は変えられない）
        (resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid)
        ||
        // アカウント引き継ぎ：有効な引き継ぎコードを持つ人だけが owner を自分に変更できる
        (request.resource.data.owner == request.auth.uid
          && request.resource.data.claimCode is string
          && exists(/databases/$(database)/documents/transfers/$(request.resource.data.claimCode))
          && get(/databases/$(database)/documents/transfers/$(request.resource.data.claimCode)).data.pid == pid)
      );
      allow delete: if false;

      // フレンド一覧（承認した側が両方に書き込む）
      match /friends/{fpid} {
        allow read: if isOwner(pid);
        allow write: if isOwner(pid) || isOwner(fpid);
      }
      // 届いたフレンド申請
      match /requests/{fromPid} {
        allow read, delete: if isOwner(pid);
        allow create, update: if isOwner(fromPid);
      }
      // 届いた対戦・トレードの招待
      match /invites/{roomId} {
        allow read, delete: if isOwner(pid);
        allow create: if signedIn() && isOwner(request.resource.data.from);
      }
    }

    // ---------- フレンドコード → プレイヤー ----------
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && isOwner(request.resource.data.pid);
      allow update, delete: if false;
    }

    // ---------- 対戦・トレードのルーム ----------
    match /rooms/{roomId} {
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && isOwner(request.resource.data.host);
      allow read, update: if signedIn() && (
        resource.data.hostUid == request.auth.uid
        || resource.data.guestUid == request.auth.uid
        || isOwner(resource.data.guest)
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    // ---------- 引き継ぎコード（ドキュメントIDそのものが秘密のコード） ----------
    match /transfers/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(request.resource.data.pid);
      allow delete: if signedIn();
    }
  }
}
