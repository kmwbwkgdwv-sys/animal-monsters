{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$pid": {
        ".write": "auth != null && newData.exists() && newData.child('owner').val() === auth.uid && (!data.exists() || data.child('owner').val() === auth.uid || (newData.child('claimCode').isString() && root.child('transfers').child(newData.child('claimCode').val()).child('pid').val() === $pid))",
        ".validate": "newData.hasChildren(['owner', 'name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
      }
    },
    "friends": {
      "$pid": {
        ".read": "auth != null && root.child('players').child($pid).child('owner').val() === auth.uid",
        "$fpid": {
          ".write": "auth != null && (root.child('players').child($pid).child('owner').val() === auth.uid || root.child('players').child($fpid).child('owner').val() === auth.uid)"
        }
      }
    },
    "requests": {
      "$pid": {
        ".read": "auth != null && root.child('players').child($pid).child('owner').val() === auth.uid",
        "$fromPid": {
          ".write": "auth != null && (root.child('players').child($pid).child('owner').val() === auth.uid || root.child('players').child($fromPid).child('owner').val() === auth.uid)"
        }
      }
    },
    "invites": {
      "$pid": {
        ".read": "auth != null && root.child('players').child($pid).child('owner').val() === auth.uid",
        "$roomId": {
          ".write": "auth != null && (root.child('players').child($pid).child('owner').val() === auth.uid || (newData.exists() && newData.child('from').isString() && root.child('players').child(newData.child('from').val()).child('owner').val() === auth.uid))"
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('pid').isString() && root.child('players').child(newData.child('pid').val()).child('owner').val() === auth.uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (data.child('guest').isString() && root.child('players').child(data.child('guest').val()).child('owner').val() === auth.uid))",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('host').isString() && root.child('players').child(newData.child('host').val()).child('owner').val() === auth.uid) || (data.exists() && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (data.child('guest').isString() && root.child('players').child(data.child('guest').val()).child('owner').val() === auth.uid))))"
      }
    },
    "transfers": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!newData.exists() || (newData.child('pid').isString() && root.child('players').child(newData.child('pid').val()).child('owner').val() === auth.uid))"
      }
    },
    "rankings": {
      ".read": "auth != null",
      ".indexOn": ["dex"],
      "$pid": {
        ".write": "auth != null && root.child('players').child($pid).child('owner').val() === auth.uid && (!newData.exists() || newData.child('owner').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('dex').isNumber() && newData.child('dex').val() >= 0 && newData.child('dex').val() <= 200)"
      }
    }
  }
}
